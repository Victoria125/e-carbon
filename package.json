{
  "name": "e-carbon",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -r -k \"pnpm dev:client\" \"pnpm dev:server\"",
    "dev:client": "dotenvx run -f .env.development -- vite",
    "dev:server": "dotenvx run -f .env.development -- tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "build": "NODE_ENV=production vite build",
    "build:analyze": "NODE_ENV=production vite build --mode analyze",
    "build:server": "tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "start:prod": "dotenvx run -f .env.production -- tsx --tsconfig tsconfig.server.json server/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "start-server-and-test dev http://localhost:5173 cypress:run",
    "test:e2e:open": "start-server-and-test dev http://localhost:5173 cypress",
    "cypress": "cypress open",
    "cypress:run": "cypress run",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down -v",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:prod": "docker compose up -d --build",
    "docker:prod:down": "docker compose down",
    "docker:prod:logs": "docker compose logs -f",
    "db:logs": "docker logs e-carbon-postgres-dev -f",
    "db:connect": "docker exec -it e-carbon-postgres-dev psql -U anamnesis -d anamnesis",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d postgres",
    "db:migrate": "dotenvx run -f .env.development -- tsx server/database/migrate.ts",
    "db:migrate:prod": "dotenvx run -f .env.production -- tsx server/database/migrate.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@maskito/core": "^4.0.0",
    "@maskito/kit": "^4.0.0",
    "@maskito/react": "^4.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-pdf/renderer": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.23.12",
    "helmet": "^8.1.0",
    "lucide-react": "^0.539.0",
    "motion": "^12.23.24",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-aria-components": "^1.12.2",
    "react-dom": "^19.1.1",
    "react-scrollbars-custom": "^4.1.1",
    "react-use-measure": "^2.1.7",
    "resend": "^6.4.1",
    "swiper": "^11.2.10",
    "tailwind-merge": "^3.3.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^5.3.0",
    "@eslint-react/eslint-plugin": "^1.53.1",
    "@iconify/react": "^6.0.2",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/cypress": "^10.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.4.0",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "4.0.3",
    "@vitest/ui": "^4.0.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cypress": "^15.5.0",
    "eslint": "^9.35.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.6",
    "start-server-and-test": "^2.1.2",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "stylelint-order": "^7.0.0",
    "tailwindcss": "^4.1.13",
    "terser": "^5.44.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.0.3"
  }
}
