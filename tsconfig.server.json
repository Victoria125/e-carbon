{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "lib": ["ES2022"],

    "baseUrl": ".",
    "rootDir": ".",
    "module": "NodeNext", // ✅ CORRETO
    "moduleResolution": "NodeNext", // ✅ CORRETO

    "paths": {
      "@/*": ["./src/*"],
      "@server/*": ["./server/*"]
    },
    "resolveJsonModule": true,
    "types": ["node"],

    "allowJs": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,

    "declaration": false,
    "noEmit": true, // ✅ CORRETO (tsx cuida da compilação)
    "outDir": "server-dist",
    "removeComments": true,
    "sourceMap": false,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "skipLibCheck": true
  }
}
